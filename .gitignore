# Build output (regenerated by `npm run build`; never committed)
dist/

# Dependencies
node_modules/

# Lockfile for the alternate package manager we don't use — keep npm's only
pnpm-lock.yaml
yarn.lock

# Coverage + mutation reports
coverage/
reports/

# Editor / IDE noise
.DS_Store
.vscode/
.idea/

# Local env / agent settings
.env
.env.*
!.env.example
.gemini/settings.local.json
.codex/config.local.json
.cursor/settings.local.json
.playwright-mcp/

# Claude Code: blanket-ignore per-machine state (settings.json, hooks/,
# scheduled_tasks.lock, transcripts, etc.). Carve out the project-shared
# dirs that should be committed when present (slash commands, subagents,
# skills, output styles). New Claude Code state files are gitignored
# automatically — no .gitignore update needed when Claude adds features.
.claude/*
!.claude/commands/
!.claude/agents/
!.claude/skills/
!.claude/output-styles/
# The /enforce skill body lives at skills/enforce/SKILL.md (the build source,
# bundled into dist/ for npm). Don't track a parallel copy here — interlinked
# enable materializes it from the source on install. One source, no drift.
.claude/skills/enforce/

# Codex CLI: blanket-ignore per-developer hook + config (same model as
# .claude/settings.json above). Contributors opt in via `interlinked enable`
# rather than inheriting a tracked config. Nothing in `.codex/` is currently
# designed to be team-shared, so no carve-outs.
.codex/*

# Generated npm pack tarballs
*.tgz

# Local archive: git bundles of branches we've deleted from the remote
# but want to keep locally "just in case" (e.g., checkpoint histories).
# See: `git bundle verify .archive/<name>.bundle`.
.archive/

# cloud/ graduated to the private `interlinked-cloud` repo — its source no longer
# lives here (interlinked-cli tracks 0 files under cloud/). What remains in the
# working tree is local-only: .dev.vars (wrangler dev SECRETS), .wrangler/ cache,
# .interlinked/ harness runtime, .claude/ settings. Blanket-ignore so a stray
# `git add -A` can never commit those secrets/cruft into this repo. (If cloud/ is
# ever re-added as a submodule, revisit this rule.)
cloud/

# Third-party reference repos cloned for design/research only — never committed.
reference-repos/

# Vitest integration-test fixtures — created/destroyed by tests, should
# never surface in git status or VS Code SCM.
#
# They live in src/lib/ (not os.tmpdir()) because the diff-overlay tsc
# gate exercised by src/commands/write.test.ts + src/commands/__tests__/
# multi-edit.test.ts resolves paths against the project's tsconfig.
# Empirically, moving to tmpdir produced exit=2 gate failures: the
# in-memory tsc Program rejects paths outside the tsconfig include scope.
#
# tsconfig.json already excludes `src/lib/_*` from global `tsc --noEmit`.
# These entries are belt-and-suspenders so git also doesn't track them —
# eliminates the create/delete flicker in SCM while keeping fixtures in
# the tsc/biome scope the gate requires.
#
# If you add a new vitest integration fixture and it starts flickering in
# git status, add its specific name here (mirror the explicitness of the
# entries below — don't use blanket `src/lib/_*` because that pattern
# also matches `src/lib/__tests__/`).
src/lib/_content_gate_fixtures/
src/lib/_gate_inline_fixture.ts
src/lib/_multi_edit_plumbing_*.ts
src/lib/_write_integration/

# Discovery / scratch scripts in scripts/ are local-only by default. Files
# already tracked here (build/CI: copy-runtime-assets, generate-docs,
# check-docs, audit-receipts, etc.) keep being tracked — gitignore only
# blocks NEW additions. Drop a `!scripts/foo.mjs` carve-out below if a
# new file in this directory needs to ship to the repo.
scripts/*
# Git hook installer + the hooks themselves ship with the repo so every
# contributor gets the pre-push test gate (see scripts/git-hooks/pre-push).
# Note: the parent ignore is `scripts/*` (not `scripts/`) so these re-
# includes actually take effect — gitignore can't re-include children of
# a fully-excluded parent directory.
!scripts/setup-git-hooks.mjs
!scripts/git-hooks/

# Session-internal phase plans + work-in-progress design notes. The older
# top-level docs/plans/*.md files (security-scanning-pillars, sondera-
# integration, etc.) predate this rule and stay tracked by listing them
# explicitly above any nested-folder ignore. Anything written into a
# subfolder under docs/plans/ is treated as personal/local-only.
docs/plans/*/

# Local manual-test scratch space and harness logs.
.scratch/

# Wrangler local-dev cache (per-Worker; lives under landing/ for the
# landing-page Worker and any future Workers added to the repo).
.wrangler/

# Interlinked: blanket-ignore harness runtime state (sessions, sockets,
# pids, audit/activity logs, caches, status files, learned rules, the
# pending review dir, etc.). Carve out the small set of files designed
# to be team-shared and committed (guard rules, project structure
# declaration, the per-file line-cap baseline). New harness state files
# added by future features are gitignored automatically — no .gitignore
# update required.
.interlinked/*
!.interlinked/guard-rules.json
!.interlinked/structure.json
!.interlinked/registry-parity.json
!.interlinked/large-files-baseline.json
!.interlinked/package-allowlist.json
!.interlinked/sanitizers.json
!.interlinked/security-config.json

# Agent-driven test reports (generated, not committed)
test/agent-driven/reports/*.json

tmp/
.interlinked/config.local.json
.interlinked/activity.jsonl
.interlinked/realtime-retry.jsonl
.interlinked/sync-errors.jsonl
.interlinked/sync-state.json
.interlinked/sessions/
.interlinked/checkpoints.json
.interlinked/guard-cache.json
.interlinked/guard-rules.local.json
.interlinked/harness.sock
.interlinked/harness.pid
.interlinked/pending-quality-warnings.json
.interlinked/index/
.interlinked/error-history.jsonl
.interlinked/collection.jsonl
.interlinked/recurrences.jsonl
.interlinked/failures/
