{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"files": {
		"includes": [
			"**/*.ts",
			"**/*.tsx",
			"**/*.js",
			"**/*.mjs",
			"!dist/**",
			"!node_modules/**",
			"!**/.wrangler/**",
			"!**/.stryker-tmp/**",
			"!coverage/**",
			"!**/reports/mutation/**",
			"!.interlinked/quarantine-*/**",
			"!.claude/workflows/**"
		]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": false,
			"suspicious": {
				"noDoubleEquals": "error",
				"noSelfCompare": "error"
			}
		}
	},
	"formatter": {
		"enabled": false
	}
}
