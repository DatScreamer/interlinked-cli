{
  "name": "interlinked-cloud",
  "main": "src/worker.ts",
  "compatibility_date": "2026-05-28",
  "account_id": "d6f63b7e2306adea17b338d4b6b4c739",
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      { "class_name": "Supervisor", "name": "SUPERVISOR" }
    ]
  },
  "kv_namespaces": [
    // workers-oauth-provider grant/token store (encrypted props, hashed secrets).
    { "binding": "OAUTH_KV", "id": "f61cfe4d7ce645ec84564bb0b3d010ed" }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Supervisor", "Facet"] },
    // v0 scaffolded a Facet DO modelled as a per-session DATA partition. That
    // mis-applies the primitive: a Facet is an isolated EXECUTION unit
    // (dynamic/untrusted code, or a static sub-agent DO class), not a data
    // bucket. Per-session/project data belongs in the Supervisor's own tables.
    // The class was never instantiated, so deleting it is safe. A real facet
    // returns later as a sub-agent execution unit (cloud-side review/test), in
    // its own migration. See docs/design/onboarding-and-connection-flow.md.
    { "tag": "v2", "deleted_classes": ["Facet"] }
  ],
  "vars": {
    "ENVIRONMENT": "development",
    // GitHub OAuth App client id — public (sent in OAuth URLs), safe to commit.
    "GITHUB_CLIENT_ID": "Ov23ctpuSM9wAaw52VlI"
  }
  // Future bindings (uncomment when wiring the corresponding capability):
  //   "ai": { "binding": "AI" }                       — Tier 2 LLM policy gate
  //   "vars": { "ANTHROPIC_API_KEY": "..." }          — Tier 3 deep review
  //   Artifacts binding                                — project state snapshots
  //   Sandbox SDK binding                              — mirror tool-based checks
  // Secrets (set with `wrangler secret put`):
  //   GITHUB_CLIENT_SECRET — GitHub OAuth App secret (upstream identity)
  //   BEARER_TOKEN — legacy shared bearer for /governor; removed in Auth D
}
