// LLM-side evaluation — see the .interlinked.cedar companion + .policy.md.
//
// ─── Lexical → Cedar mapping ───────────────────────────
//
//   "Always work on copies, never originals"  →  P1 (forbid FileWrite/Edit/Delete + ShellCommand)
//   "Verify image integrity ... before"        →  P3 (NOT EMITTED here — see .interlinked.cedar)
//   "Mount everything read-only"               →  P2 (forbid ShellCommand without -o ro)
//   "Preserve timestamps — never modify"       →  P4 (forbid ShellCommand touch -t/-d)
//   "Refuse evidence tampering ..."            →  P5 (NOT EMITTED — pure intent, see .policy.md)

// ═══════════════════════════════════════════════════════
// P1 — Never write to or modify the original disk image
// ═══════════════════════════════════════════════════════

@id("enforce-skill-disk-forensics-no-evidence-writes")
@description("Never write to or modify the original disk image. Always work on copies, never originals.")
@source_quote("Always work on copies, never originals")
@source_file("reference-repos/cybersecurity-skills/skills/disk-forensics/SKILL.md")
@source_lines("14,18")
@severity("critical")
forbid (
    principal,
    action in [Action::"FileWrite", Action::"FileEdit", Action::"FileDelete"],
    resource
) when {
    context.path like "*.E01" ||
    context.path like "*.E02" ||
    context.path like "*.dd" ||
    context.path like "*.raw" ||
    context.path like "*.vmdk" ||
    context.path like "*.vhd" ||
    context.path like "*.aff" ||
    context.path like "*.aff2" ||
    context.path like "*.aff4" ||
    context.path like "*/evidence/*"
};

@id("enforce-skill-disk-forensics-no-evidence-writes-via-shell")
@description("Block shell-level writes to disk-image paths (dd, > redirects, >> appends).")
@source_quote("Always work on copies, never originals")
@source_file("reference-repos/cybersecurity-skills/skills/disk-forensics/SKILL.md")
@source_lines("14,18")
@severity("critical")
forbid (
    principal,
    action == Action::"ShellCommand",
    resource
) when {
    context.command like "*dd *of=*.E01*" ||
    context.command like "*dd *of=*.E02*" ||
    context.command like "*dd *of=*.dd*" ||
    context.command like "*dd *of=*.raw*" ||
    context.command like "*dd *of=*.vmdk*" ||
    context.command like "*dd *of=*.vhd*" ||
    context.command like "*> *.E01*" ||
    context.command like "*> *.dd*" ||
    context.command like "*> *.raw*" ||
    context.command like "*>> *.E01*" ||
    context.command like "*>> *.dd*" ||
    context.command like "*>> *.raw*"
};

// ═══════════════════════════════════════════════════════
// P2 — Mount disk images read-only
// ═══════════════════════════════════════════════════════
//
// Note: Cedar `like` is glob-only, not regex. The regex equivalent
// (`^mount\b(?!.*-o\s+[^&|;]*\bro\b)`) uses negative lookahead, which
// Cedar can't express directly. This rule uses a positive-match with
// negated-exception structure. Some uncommon flag arrangements (e.g.,
// "-o ro,sync" passed as a positional argument before the mountpoint)
// may produce false negatives. The deterministic regex in
// distilled-rules.json handles those edge cases.

@id("enforce-skill-disk-forensics-mount-readonly")
@description("Mount disk images read-only. Block mount commands missing -o ro / -r / --read-only.")
@source_quote("Mount everything read-only")
@source_file("reference-repos/cybersecurity-skills/skills/disk-forensics/SKILL.md")
@source_lines("16,144")
@severity("high")
@confidence("approximate")
forbid (
    principal,
    action == Action::"ShellCommand",
    resource
) when {
    context.command like "*mount *" &&
    !(context.command like "*-o ro*" ||
      context.command like "*-o *,ro*" ||
      context.command like "*-o *,*,ro*" ||
      context.command like "*-o ro,*" ||
      context.command like "* -r *" ||
      context.command like "*--read-only*")
};

// ═══════════════════════════════════════════════════════
// P3 — Verify image hash before first analysis
// ═══════════════════════════════════════════════════════
//
// NOT EMITTED in Sondera-compatible form.
//
// This policy requires session-state awareness (was a hash command run
// earlier in this session against the same image path?). Sondera's
// base.cedarschema exposes Trajectory.step_count but not the list of
// commands_run, so the precondition can't be expressed in vanilla Cedar.
//
// See skill-disk-forensics.interlinked.cedar for the extended-schema
// version. The Tier 2 LLM policy gate evaluates this directly from
// trajectory and does not need the Cedar form.

// ═══════════════════════════════════════════════════════
// P4 — Never modify file timestamps on extracted artifacts
// ═══════════════════════════════════════════════════════

@id("enforce-skill-disk-forensics-no-timestamp-rewrite")
@description("Block touch -t / -d / --date / --reference — these rewrite file timestamps and constitute evidence tampering.")
@source_quote("Preserve timestamps — never modify source evidence")
@source_file("reference-repos/cybersecurity-skills/skills/disk-forensics/SKILL.md")
@source_lines("18,147")
@severity("high")
forbid (
    principal,
    action == Action::"ShellCommand",
    resource
) when {
    context.command like "*touch -t *" ||
    context.command like "*touch -d *" ||
    context.command like "*touch --date*" ||
    context.command like "*touch --reference*"
};

