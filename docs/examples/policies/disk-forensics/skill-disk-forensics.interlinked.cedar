// ═══════════════════════════════════════════════════════
// P3 — Verify image hash before first analysis
// ═══════════════════════════════════════════════════════
//
// Trigger: first Sleuth Kit / carving tool call in session targeting an
// image path, without a prior hash-verification command on the same path.
//
// Decision: this is a `warn` policy, not `block`. The Tier 2 LLM may
// upgrade severity on repeat violations. Cedar's standard decision set is
// permit/forbid — the @action_on_violation annotation extends that to a
// three-state decision (warn/block/ask) understood by Interlinked engines.
// Vanilla Cedar engines see the annotation as a no-op and treat the
// policy as forbid (which is over-strict but not unsafe).

@id("enforce-skill-disk-forensics-verify-hash-before-analysis")
@description("Warn when Sleuth Kit / carving analysis runs without a prior hash verification on the same image earlier in the session.")
@source_quote("Verify image integrity with hash comparison before analysis")
@source_file("reference-repos/cybersecurity-skills/skills/disk-forensics/SKILL.md")
@source_lines("15,15")
@severity("medium")
@action_on_violation("warn")
@requires_extension("skill_scope")
@requires_extension("commands_run")
forbid (
    principal,
    action == Action::"ShellCommand",
    resource is Trajectory
) when {
    context.skill_active == "disk-forensics" &&
    (context.command like "*fls *" ||
     context.command like "*icat *" ||
     context.command like "*mmls *" ||
     context.command like "*fsstat *" ||
     context.command like "*foremost*" ||
     context.command like "*scalpel*" ||
     context.command like "*bulk_extractor*") &&
    !resource.commands_run.any(cmd,
        cmd like "*sha256sum *" ||
        cmd like "*md5sum *" ||
        cmd like "*ewfverify*" ||
        cmd like "*shasum *")
};
