{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interlinked.quentincody.dev/protocol/mutation-v3/report.schema.json",
  "title": "Interlinked mutation protocol v3 — structural report",
  "description": "The retrieved report bytes must parse to this shape. Cross-field invariants enforced by the reference verifier (report.ts) beyond this schema: files carries EXACTLY one entry — the envelope's job.target_file; row mutant_ids are unique; executable and excluded rows each correspond one-to-one with the envelope's full identity provenance, plus status and policy_id where applicable; not_mutatable requires an empty mutants array.",
  "type": "object",
  "additionalProperties": false,
  "required": ["report_version", "files"],
  "properties": {
    "report_version": { "const": "1" },
    "files": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mutants"],
        "properties": {
          "mutants": {
            "type": "array",
            "maxItems": 65536,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["mutant_id", "site_id", "symbol_id", "qualified_name", "symbol_context", "mutator", "original_lexeme", "replacement", "start_offset", "ordinal_within_symbol", "policy_id", "status"],
                  "properties": {
                    "mutant_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                    "site_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                    "symbol_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                    "qualified_name": { "type": "string", "minLength": 1, "maxLength": 512 },
                    "symbol_context": { "type": "string", "minLength": 1, "maxLength": 512 },
                    "mutator": { "type": "string", "minLength": 1, "maxLength": 512 },
                    "original_lexeme": { "type": "string", "maxLength": 512 },
                    "replacement": { "type": "string", "maxLength": 512 },
                    "start_offset": { "type": "integer", "minimum": 0, "maximum": 9007199254740991, "description": "Zero-based UTF-16 code-unit offset (JavaScript string index) in the hash-bound target content." },
                    "ordinal_within_symbol": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                    "policy_id": { "type": "string", "pattern": "^policy-[a-z0-9][a-z0-9-]{1,62}$" },
                    "status": { "const": "excluded" }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["mutant_id", "site_id", "symbol_id", "qualified_name", "symbol_context", "mutator", "original_lexeme", "replacement", "start_offset", "ordinal_within_symbol", "status"],
                  "properties": {
                    "mutant_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                    "site_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                    "symbol_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                    "qualified_name": { "type": "string", "minLength": 1, "maxLength": 512 },
                    "symbol_context": { "type": "string", "minLength": 1, "maxLength": 512 },
                    "mutator": { "type": "string", "minLength": 1, "maxLength": 512 },
                    "original_lexeme": { "type": "string", "maxLength": 512 },
                    "replacement": { "type": "string", "maxLength": 512 },
                    "start_offset": { "type": "integer", "minimum": 0, "maximum": 9007199254740991, "description": "Zero-based UTF-16 code-unit offset (JavaScript string index) in the hash-bound target content." },
                    "ordinal_within_symbol": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                    "status": { "enum": ["killed", "survived", "timeout", "uncovered", "indeterminate"] }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
