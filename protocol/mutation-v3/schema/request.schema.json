{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interlinked.quentincody.dev/protocol/mutation-v3/request.schema.json",
  "title": "Interlinked mutation protocol v3 — job request",
  "description": "The canonical mutation job request the CLI submits; job tenant/project are caller expectations that the server MUST compare with independently authenticated authority. source_artifact is an opaque, format/hash/length binding to an out-of-band full repository snapshot plus overlay, never an R2 key; format is fixed so an executor never guesses how to decode authenticated bytes. The acceptance receipt's request_hash binds sha256(canonicalJson({...request, changeset: sorted})) and changeset_hash binds sha256(canonicalJson({changeset_version:'1', entries: sorted})). Invariants beyond this schema (request.ts is normative): changeset paths are UNIQUE; sorting is lexicographic UTF-16 code-unit order; test_files carry no duplicates.",
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "boundedString": { "type": "string", "minLength": 1, "maxLength": 512 },
    "fullCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sourceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "artifact_id", "sha256", "bytes"],
      "properties": {
        "format": { "const": "git-archive-tar-v1" },
        "artifact_id": { "type": "string", "pattern": "^src_[A-Za-z0-9][A-Za-z0-9_-]{2,124}$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 67108864 }
      }
    },
    "repoPath": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$))(?!.*//)[^\\\\]+$" }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["request_version", "protocol_version", "job", "source_artifact", "scope_mode", "test_files", "changeset"],
  "properties": {
    "request_version": { "const": "1" },
    "protocol_version": { "const": "interlinked-mutation/3.0" },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant", "project", "repository", "commit", "target_file", "target_content_hash", "job_key"],
      "properties": {
        "tenant": { "$ref": "#/$defs/boundedString" },
        "project": { "$ref": "#/$defs/boundedString" },
        "repository": { "$ref": "#/$defs/boundedString" },
        "commit": { "$ref": "#/$defs/fullCommit" },
        "target_file": { "$ref": "#/$defs/repoPath" },
        "target_content_hash": { "$ref": "#/$defs/sha256" },
        "job_key": { "$ref": "#/$defs/boundedString" }
      }
    },
    "source_artifact": { "$ref": "#/$defs/sourceArtifact" },
    "scope_mode": { "enum": ["import_graph", "companion_fallback", "glob_fallback"] },
    "test_files": { "type": "array", "maxItems": 4096, "uniqueItems": true, "items": { "$ref": "#/$defs/repoPath" } },
    "changeset": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "content_hash"],
        "properties": {
          "path": { "$ref": "#/$defs/repoPath" },
          "content_hash": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  }
}
